# Anthropic API Key — obtenela en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Tu cuenta de Gmail desde la que se envía el digest
GMAIL_USER=tu@gmail.com

# App Password de Google (no es tu contraseña normal)
# Generala en: https://myaccount.google.com/apppasswords
# Requiere tener 2FA activado en tu cuenta Google
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email destinatario del digest (puede ser el mismo que GMAIL_USER)
RECIPIENT_EMAIL=tu@gmail.com
